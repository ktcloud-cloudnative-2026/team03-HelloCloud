# 사용법: cp deploy/ci/.env.example deploy/ci/.env 후 값을 채운다. .env는 커밋하지 않는다.

# 젠킨스 관리자(admin) 비밀번호 — $나 # 같은 특수문자가 있으면 작은따옴표로 감싼다: 'p@ss$word'
JENKINS_ADMIN_PASSWORD=
# GitHub 계정 이름과 토큰 (Classic 토큰 권한: repo, write:packages)
#  - repo: 코드 읽기, main에 dev 이미지 태그 push, 상태 체크
#  - write:packages: GHCR에 이미지 올리기
GITHUB_USERNAME=
GITHUB_TOKEN=

# 컨트롤러 → 에이전트 SSH 키 한 쌍 (ssh-keygen -t ed25519 -N "" -f agent_key 로 생성)
AGENT_SSH_PUBLIC_KEY=
AGENT_SSH_PRIVATE_KEY=

# VM의 docker 그룹 번호: getent group docker | cut -d: -f3
DOCKER_GID=
