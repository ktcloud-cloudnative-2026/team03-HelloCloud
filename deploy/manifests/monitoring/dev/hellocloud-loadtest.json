{
  "uid": "hellocloud-loadtest",
  "title": "HelloCloud 부하 테스트",
  "tags": [
    "hellocloud",
    "loadtest"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "서비스 (user · file · chat)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "요청 수 (초당)",
      "description": "k6가 보내는 요청이 들어오는지. 건강 확인 · /metrics 제외",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job)(rate(http_server_requests_seconds_count{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "에러율 (5xx)",
      "description": "합격선 1%. 5xx가 없으면 0",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "axisSoftMax": 0.05
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (job)(rate(http_server_requests_seconds_count{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\", status=~\"5..\"}[1m])) or sum by (job)(rate(http_server_requests_seconds_count{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\"}[1m])) * 0) / sum by (job)(rate(http_server_requests_seconds_count{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "응답 시간 p95",
      "description": "합격선 500ms(빨간 선). 파드가 막 뜬 직후는 높게 나온다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "axisSoftMax": 0.6
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (job, le)(rate(http_server_requests_seconds_bucket{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\"}[1m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU 사용률 (requests 대비)",
      "description": "HPA가 보는 값. 70%(빨간 선)를 넘으면 파드를 늘린다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "axisSoftMax": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"ideaconnection-dev\", container!=\"\", pod=~\"(user|file|chat)-service-.*\"}[1m])) / sum by (pod)(kube_pod_container_resource_requests{namespace=\"ideaconnection-dev\", resource=\"cpu\", pod=~\"(user|file|chat)-service-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "파드 수",
      "description": "Ready인 파드 수와 HPA가 원하는 수. HPA를 끄면 원하는 수 선이 없다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisSoftMax": 4
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=\"ideaconnection-dev\", deployment=~\"user-service|file-service|chat-service\"}",
          "legendFormat": "{{deployment}} 실제"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"ideaconnection-dev\"}",
          "legendFormat": "{{horizontalpodautoscaler}} 원하는 수"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "노드 CPU 사용률",
      "description": "k6와 대상이 같은 노드면 함께 오른다. 결과가 흔들리는지 볼 때",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg by (instance)(rate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "분산 · 부하 도구",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "파드별 요청 수 (초당)",
      "description": "HPA로 파드가 늘었을 때 요청이 파드마다 고르게 나뉘는지(P4 기본 (2) 레플리카 간 분산)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod)(rate(http_server_requests_seconds_count{job=~\"user-service|file-service|chat-service\", uri!=\"/metrics\", uri!~\"/health.*\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "k6 CPU (코어)",
      "description": "k6가 상한(2코어, 빨간 선)에 닿으면 서비스가 아니라 측정 도구의 한계다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"loadtest\", container=\"k6\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Keycloak CPU (코어)",
      "description": "계단이 오를 때 새 가상 사용자 로그인으로 튀는지",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"keycloak\", container!=\"\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "DB VM (t4-db)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB VM CPU",
      "description": "DB가 먼저 지치는지",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{vm=\"t4-db\", mode=\"idle\"}[1m]))",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB VM 남은 메모리",
      "description": "3.8Gi 중 남은 양",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemAvailable_bytes{vm=\"t4-db\"}",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "DB 연결 수",
      "description": "파드가 늘면 연결도 늘어난다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mysql_global_status_threads_connected{vm=\"t4-db\"}",
          "legendFormat": "MySQL"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_connections{vm=\"t4-db\", state=\"current\"}",
          "legendFormat": "MongoDB"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "redis_connected_clients{vm=\"t4-db\"}",
          "legendFormat": "Redis"
        }
      ]
    }
  ]
}